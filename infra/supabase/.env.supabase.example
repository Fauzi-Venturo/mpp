# Supabase connection template for apps/api/.env
# Copy the relevant lines into apps/api/.env and fill in your project values.

DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<your-supabase-db-password>
DB_NAME=postgres
DB_SSLMODE=require

# Keep the pool modest on a direct connection.
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Redis is NOT provided by Supabase — point these at a separate Redis
# (compose service locally, or a hosted provider such as Upstash).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=10
