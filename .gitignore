# ── Monorepo root ───────────────────────────────────────────────
.env
.env.local
*.local
.DS_Store

# ── Backend (apps/api — Go) ─────────────────────────────────────
apps/api/bin/
apps/api/tmp/
apps/api/.env
apps/api/*.test
apps/api/coverage.out

# ── Frontend (apps/web — Next.js / Yarn 1) ──────────────────────
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.env
apps/web/.env.production
apps/web/.env.prod
apps/web/next-env.d.ts
apps/web/.turbo/

# ── Tooling / editors ───────────────────────────────────────────
node_modules/
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# ── Infra / secrets ─────────────────────────────────────────────
infra/**/*.secret
*.pem
service-account*.json
