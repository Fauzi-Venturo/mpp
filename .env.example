# ============================================================================
# MPP Monorepo — root compose environment
# ----------------------------------------------------------------------------
# Copy to `.env` (used by docker-compose.yml). App-specific config lives in
# apps/api/.env and apps/web/.env — see each app's .env.example.
# ============================================================================

# ── Postgres (compose service `postgres`) ───────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mpp
POSTGRES_PORT=5432

# ── Redis (compose service `redis`) ─────────────────────────────────────────
# Required by BOTH the backend RBAC permission cache AND the queue engine
# (number counters / active-queue state / pub-sub). Supabase does NOT provide
# Redis — see infra/supabase/README.md.
REDIS_PORT=6379

# ── Backend (compose service `api`) ─────────────────────────────────────────
API_PORT=8080
JWT_SECRET=change-me-in-production-min-32-characters-long
ENV=development

# ── Frontend (compose service `web`) ────────────────────────────────────────
WEB_PORT=8002
# Browser-reachable backend URL baked into the Next bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_COMPANY_SLUG=mpp
NEXT_PUBLIC_CLIENT_SLUG=mpp
